rules_version = '2';

// FlickPick Firestore security rules.
// Apply via Firebase Console → Firestore Database → Rules, or `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user may read and write ONLY their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
