{
  "rules": {
    ".read": false,
    ".write": false,

    "parties": {
      "$code": {
        ".read": "auth != null",

        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('metadata').child('hostId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('metadata').child('hostId').val() === auth.uid || data.child('metadata').child('createdAt').val() < (now - 86400000))))",

        "metadata": {
          ".write": "auth != null && data.child('hostId').val() === auth.uid",

          "hostId": {
            ".write": "auth != null && newData.val() === auth.uid && root.child('parties').child($code).child('members').child(auth.uid).exists() && !root.child('parties').child($code).child('members').child(data.val()).exists()"
          },

          "status": {
            ".write": "auth != null && newData.val() === 'finished' && root.child('parties').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'active' || newData.val() === 'finished')"
          },

          "movieNight": {
            ".write": "auth != null && root.child('parties').child($code).child('members').child(auth.uid).exists()"
          }
        },

        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('parties').child($code).child('metadata').child('hostId').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 30)"
          }
        },

        "movieData": {
          ".write": "auth != null && root.child('parties').child($code).child('metadata').child('hostId').val() === auth.uid"
        },

        "votes": {
          ".write": "auth != null && root.child('parties').child($code).child('metadata').child('hostId').val() === auth.uid",

          "$movieId": {
            "$voterUid": {
              ".write": "auth != null && auth.uid === $voterUid && (!newData.exists() || root.child('parties').child($code).child('members').child(auth.uid).exists())",
              ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'yes' || newData.val() === 'no'))"
            }
          }
        },

        "reactions": {
          "$movieId": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('parties').child($code).child('members').child(auth.uid).exists()",
              ".validate": "!newData.exists() || (newData.hasChild('emoji') && newData.child('emoji').isString() && newData.child('emoji').val().length <= 8 && newData.hasChild('timestamp') && newData.child('timestamp').isNumber())"
            }
          }
        }
      }
    }
  }
}
